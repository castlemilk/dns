#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - dnsutils
  - docker.io

write_files:
  - path: /etc/systemd/system/simpledns-authority.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Simple DNS read-only authority
      Wants=network-online.target docker.service
      After=network-online.target docker.service
      ConditionPathExists=/etc/simpledns/authority.env

      [Service]
      Type=simple
      Restart=always
      RestartSec=5s
      TimeoutStartSec=180s
      TimeoutStopSec=45s
      StandardOutput=journal
      StandardError=journal
      ExecStartPre=-/usr/bin/docker rm -f simpledns-authority
      # A reboot must remain possible during a registry outage once the pinned
      # image is cached locally. Pull only on the first start.
      ExecStartPre=/bin/sh -c '/usr/bin/docker image inspect ${image_ref} >/dev/null 2>&1 || /usr/bin/docker pull ${image_ref}'
      ExecStart=/usr/bin/docker run --name simpledns-authority \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges:true \
        --pids-limit=256 \
        --memory=256m \
        --cpus=0.75 \
        --log-driver=none \
        --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=16m,mode=1777 \
        --publish=53:1053/tcp \
        --publish=53:1053/udp \
        --publish=127.0.0.1:8080:8080/tcp \
        --env=DNS_ROLE=authority \
        --env=DNS_PRODUCTION=true \
        --env=DNS_HTTP_ADDR=:8080 \
        --env=DNS_LISTEN_ADDR=:1053 \
        --env=DNS_NAMESERVERS=${primary_nameserver},${second_nameserver} \
        --env=DNS_SNAPSHOT_URL=${snapshot_url} \
        --env=DNS_SNAPSHOT_CACHE_PATH=/cache/snapshot.json \
        --env=DNS_SNAPSHOT_POLL_INTERVAL=5s \
        --env=DNS_SNAPSHOT_MAX_STALENESS=24h \
        --env=DNS_SNAPSHOT_HTTP_TIMEOUT=5s \
        --env=DNS_SNAPSHOT_MAX_BODY_BYTES=8388608 \
        --env=DNS_SHUTDOWN_TIMEOUT=20s \
        --env-file=/etc/simpledns/authority.env \
        --volume=/var/lib/simpledns:/cache:rw \
        ${image_ref}
      ExecStop=/usr/bin/docker stop --time=20 simpledns-authority

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/sbin/simpledns-healthcheck
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      curl --fail --silent --show-error --max-time 3 http://127.0.0.1:8080/readyz >/dev/null

runcmd:
  - [install, -d, -o, "65532", -g, "65532", -m, "0700", /var/lib/simpledns]
  - [install, -d, -o, root, -g, root, -m, "0700", /etc/simpledns]
  - [systemctl, enable, docker.service]
  - [systemctl, start, docker.service]
  - [systemctl, daemon-reload]
  - [systemctl, enable, simpledns-authority.service]

final_message: "Simple DNS authority host is prepared; inject /etc/simpledns/authority.env with bootstrap-authority.sh before starting it."
