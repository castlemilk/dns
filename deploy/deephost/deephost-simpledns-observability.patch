 {{- end }}
+{{- if .Values.monitoring.prometheus.scrapeSimpleDNS }}
+  # Each OpenTelemetry Collector replica owns independent in-memory exporter
+  # state. Headless DNS discovery scrapes every pod without cross-namespace
+  # Kubernetes API RBAC or random ClusterIP backend selection.
+  - job_name: simpledns-otel-metrics
+    metrics_path: /metrics
+    dns_sd_configs:
+      - names:
+          - {{ printf "%s.%s.svc.cluster.local" .Values.monitoring.prometheus.simpleDNS.metricsService .Values.monitoring.prometheus.simpleDNS.namespace | quote }}
+        type: A
+        port: 8889
+        refresh_interval: 30s
+  - job_name: simpledns-otel-collector
+    metrics_path: /metrics
+    dns_sd_configs:
+      - names:
+          - {{ printf "%s.%s.svc.cluster.local" .Values.monitoring.prometheus.simpleDNS.metricsService .Values.monitoring.prometheus.simpleDNS.namespace | quote }}
+        type: A
+        port: 8888
