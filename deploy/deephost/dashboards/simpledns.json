{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "description": "Healthy metrics and collector scrape targets should each be 2; collector replicas should be 2; authority replicas should be 3.",
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "A"},
            "properties": [
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}}
            ]
          },
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}}
            ]
          },
          {
            "matcher": {"id": "byFrameRefID", "options": "C"},
            "properties": [
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}}
            ]
          },
          {
            "matcher": {"id": "byFrameRefID", "options": "D"},
            "properties": [
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 3}]}}
            ]
          }
        ]
      },
      "gridPos": {"h": 5, "w": 16, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {"expr": "sum(up{job=\"simpledns-otel-metrics\"}) or vector(0)", "instant": true, "legendFormat": "metrics scrapes / 2", "refId": "A"},
        {"expr": "sum(up{job=\"simpledns-otel-collector\"}) or vector(0)", "instant": true, "legendFormat": "collector scrapes / 2", "refId": "B"},
        {"expr": "count(count by (instance) (otelcol_process_uptime{service_name=\"simpledns-otel-collector\",service_namespace=\"dns\"})) or vector(0)", "instant": true, "legendFormat": "collectors / 2", "refId": "C"},
        {"expr": "count(count by (k8s_pod_name) (simpledns_snapshot_ready{service_name=\"simpledns-authority\",service_namespace=\"dns\"})) or vector(0)", "instant": true, "legendFormat": "authorities / 3", "refId": "D"}
      ],
      "title": "Scrape and replica coverage",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "description": "Current firing state from the standalone SimpleDNS Prometheus rules.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"color": "green", "index": 0, "text": "None"}, "1": {"color": "red", "index": 1, "text": "Firing"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {"expr": "max by (alertname, severity, component) (ALERTS{alertname=~\"SimpleDNS.*\",alertstate=\"firing\"}) or on() vector(0)", "instant": true, "legendFormat": "{{alertname}}", "refId": "A"}
      ],
      "title": "Firing SimpleDNS alerts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {"defaults": {"unit": "suffix:qps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "id": 3,
      "targets": [
        {"expr": "sum by (dns_response_code) (rate(simpledns_dns_queries_total{service_name=\"simpledns-authority\",service_namespace=\"dns\"}[5m]))", "legendFormat": "{{dns_response_code}}", "refId": "A"}
      ],
      "title": "Authoritative query rate by response code",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "max": 1,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "id": 4,
      "targets": [
        {"expr": "(sum(rate(simpledns_dns_queries_total{service_name=\"simpledns-authority\",service_namespace=\"dns\",dns_response_code=\"SERVFAIL\"}[5m])) or vector(0)) / clamp_min(sum(rate(simpledns_dns_queries_total{service_name=\"simpledns-authority\",service_namespace=\"dns\"}[5m])), 0.001)", "legendFormat": "SERVFAIL", "refId": "A"}
      ],
      "title": "SERVFAIL ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "id": 5,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(simpledns_dns_query_duration_seconds_bucket{service_name=\"simpledns-authority\",service_namespace=\"dns\"}[5m])))", "legendFormat": "p95", "refId": "A"}
      ],
      "title": "DNS query latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1e-12}]},
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
      "id": 6,
      "targets": [
        {"expr": "sum by (k8s_pod_name, network_transport) (rate(simpledns_dns_write_failures_total{service_name=\"simpledns-authority\",service_namespace=\"dns\"}[5m])) or on() vector(0)", "legendFormat": "{{k8s_pod_name}} {{network_transport}}", "refId": "A"}
      ],
      "title": "DNS response write failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 300}]},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13},
      "id": 7,
      "targets": [
        {"expr": "max by (k8s_pod_name) (simpledns_snapshot_age_seconds{service_name=\"simpledns-authority\",service_namespace=\"dns\"})", "legendFormat": "{{k8s_pod_name}}", "refId": "A"}
      ],
      "title": "Authority snapshot age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 0, "text": "Not ready"}, "1": {"color": "green", "index": 1, "text": "Ready"}}, "type": "value"}
          ],
          "max": 1,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13},
      "id": 8,
      "targets": [
        {"expr": "min by (k8s_pod_name) (simpledns_snapshot_ready{service_name=\"simpledns-authority\",service_namespace=\"dns\"})", "legendFormat": "{{k8s_pod_name}}", "refId": "A"}
      ],
      "title": "Authority snapshot ready",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1e-12}]},
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "id": 9,
      "targets": [
        {"expr": "sum by (k8s_pod_name, outcome) (rate(simpledns_snapshot_fetches_total{service_name=\"simpledns-authority\",service_namespace=\"dns\",outcome=~\"request_error|transport_error|http_error|read_error|apply_error\"}[5m])) or on() vector(0)", "legendFormat": "fetch {{k8s_pod_name}} {{outcome}}", "refId": "A"},
        {"expr": "sum by (k8s_pod_name, source, outcome) (rate(simpledns_snapshot_applies_total{service_name=\"simpledns-authority\",service_namespace=\"dns\",outcome!=\"success\"}[5m])) or on() vector(0)", "legendFormat": "apply {{k8s_pod_name}} {{source}} {{outcome}}", "refId": "B"}
      ],
      "title": "Snapshot refresh failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "id": 10,
      "targets": [
        {"expr": "sum by (k8s_pod_name, outcome) (rate(simpledns_readiness_checks_total{service_name=\"simpledns-control\",service_namespace=\"dns\"}[5m]))", "legendFormat": "readiness {{k8s_pod_name}} {{outcome}}", "refId": "A"},
        {"expr": "sum by (k8s_pod_name, operation, error_type) (rate(simpledns_control_mutations_total{service_name=\"simpledns-control\",service_namespace=\"dns\",outcome=\"error\"}[5m]))", "legendFormat": "mutation {{k8s_pod_name}} {{operation}} {{error_type}}", "refId": "B"}
      ],
      "title": "Control readiness and mutation failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 29},
      "id": 11,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {"expr": "max(simpledns_inventory_zones{service_name=\"simpledns-control\",service_namespace=\"dns\"})", "instant": true, "legendFormat": "zones", "refId": "A"},
        {"expr": "max(simpledns_inventory_records{service_name=\"simpledns-control\",service_namespace=\"dns\"})", "instant": true, "legendFormat": "records", "refId": "B"}
      ],
      "title": "Published inventory",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 29},
      "id": 12,
      "targets": [
        {"expr": "sum by (k8s_pod_name) (rate(simpledns_web_server_requests_total{service_name=\"simpledns-web\",service_namespace=\"dns\"}[5m]))", "legendFormat": "all requests {{k8s_pod_name}}", "refId": "A"},
        {"expr": "sum by (k8s_pod_name) (rate(simpledns_web_health_requests_total{service_name=\"simpledns-web\",service_namespace=\"dns\"}[5m]))", "legendFormat": "health subset {{k8s_pod_name}}", "refId": "B"},
        {"expr": "sum by (k8s_pod_name) (rate(simpledns_web_server_errors_total{service_name=\"simpledns-web\",service_namespace=\"dns\"}[5m]))", "legendFormat": "errors {{k8s_pod_name}}", "refId": "C"}
      ],
      "title": "Web request, health, and error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 29},
      "id": 13,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, k8s_pod_name) (rate(simpledns_web_server_request_duration_seconds_bucket{service_name=\"simpledns-web\",service_namespace=\"dns\"}[5m])))", "legendFormat": "p95 {{k8s_pod_name}}", "refId": "A"}
      ],
      "title": "Web request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "deephost-prometheus"},
      "fieldConfig": {
        "defaults": {
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1e-12}]},
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
      "id": 14,
      "targets": [
        {"expr": "sum by (instance) (rate(otelcol_exporter_send_failed_metric_points{service_name=\"simpledns-otel-collector\",service_namespace=\"dns\"}[5m]))", "legendFormat": "{{instance}} export failed", "refId": "A"},
        {"expr": "sum by (instance) (rate(otelcol_receiver_refused_metric_points{service_name=\"simpledns-otel-collector\",service_namespace=\"dns\"}[5m]))", "legendFormat": "{{instance}} metric points refused", "refId": "B"},
        {"expr": "sum by (instance) (rate(otelcol_receiver_refused_spans{service_name=\"simpledns-otel-collector\",service_namespace=\"dns\"}[5m]))", "legendFormat": "{{instance}} spans refused", "refId": "C"}
      ],
      "title": "Collector telemetry loss by instance",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["simpledns", "dns", "opentelemetry"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "utc",
  "title": "SimpleDNS Operations",
  "uid": "simpledns-operations",
  "version": 2
}
