# Runtime role. "all" preserves the local single-process server. In a split
# deployment, run one "control" writer and one or more "authority" readers.
DNS_ROLE=all

# Enables production configuration checks for reserved nameservers, snapshot
# transport, and bearer-token strength. Split roles require tokens either way.
DNS_PRODUCTION=false

# HTTP serves the control API in all/control and health probes in every role.
# Kubernetes maps public DNS port 53 to container port 1053 in all/authority.
DNS_HTTP_ADDR=:8080
DNS_LISTEN_ADDR=:1053

# Local path by default; the Helm chart overrides this to /data/dns.db on a PVC.
DNS_DATA_PATH=./data/dns.db

# Comma-separated authoritative nameserver hostnames added to managed zone records.
# Replace these before hosting a delegated zone and configure registrar/parent glue.
DNS_NAMESERVERS=ns1.example.net,ns2.example.net

# Comma-separated browser origins allowed to call the Connect API. CORS is not auth.
DNS_CORS_ORIGINS=http://localhost:3000

# Control API authentication. Optional only for a non-production DNS_ROLE=all
# with no real engine: HOSTING_API_URL below points at the local kind DeepHost,
# and a real hosting or mail engine — or BILLING_PROVIDER=stripe — makes this
# mandatory, because those RPCs spend the engine credential, return a mailbox
# password once, and can delete apps, mailboxes and zones. Startup fails with
# an empty value in that combination rather than serving them unauthenticated.
# Required in control and production all; production tokens need 32+ characters.
# Send as: Authorization: Bearer <token>.
DNS_API_BEARER_TOKEN=local-operator-token

# Separate credential for GET /internal/v1/snapshot. Required in control and
# authority roles. Production tokens need 32+ characters. Do not reuse the API token.
DNS_SNAPSHOT_BEARER_TOKEN=

# Full internal control snapshot URL used only by authority processes.
DNS_SNAPSHOT_URL=http://dns-control:8080/internal/v1/snapshot

# Authority polling, last-known-good cache, freshness, and transfer bounds.
DNS_SNAPSHOT_POLL_INTERVAL=5s
DNS_SNAPSHOT_MAX_STALENESS=1m
DNS_SNAPSHOT_HTTP_TIMEOUT=5s
DNS_SNAPSHOT_CACHE_PATH=./data/snapshot.json
DNS_SNAPSHOT_MAX_BODY_BYTES=8388608

# Maximum inbound HTTP request body accepted by the Connect/control listener.
DNS_HTTP_MAX_BODY_BYTES=1048576

# Optional: create this zone only when the database contains no zones.
DNS_BOOTSTRAP_ZONE=

# EDNS UDP response ceiling (512-65535). 1232 is the conservative default.
DNS_MAX_UDP_SIZE=1232

# Go duration used for HTTP and DNS graceful shutdown.
DNS_SHUTDOWN_TIMEOUT=10s

# Server-side OpenTelemetry. Leave exporters as "none" for a network-silent
# local process, or set both to "otlp" with an OTLP/HTTP collector endpoint.
# Never put bearer tokens, DNS names, record values, or other managed data in
# OTEL_RESOURCE_ATTRIBUTES or exporter headers.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=simpledns-local
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_METRICS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_METRIC_EXPORT_TIMEOUT=10000
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_PROPAGATORS=tracecontext,baggage

# Browser-visible Connect API origin. Required for split-origin local development.
# Leave unset in a same-origin deployment where HTTPRoute serves UI and API together.
NEXT_PUBLIC_DNS_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Platform state (writer roles only; rejected for DNS_ROLE=authority)
# ---------------------------------------------------------------------------

# Sites, mail bindings, subscriptions, the webhook queue and the activity log.
# A separate bbolt file so the zone store's bucket invariants, the snapshot feed
# and dns-restore are untouched. Defaults to platform.db beside DNS_DATA_PATH;
# must differ from DNS_DATA_PATH and DNS_SNAPSHOT_CACHE_PATH.
DNS_PLATFORM_PATH=./data/platform.db

# Size of the activity ring (1000-1000000). The janitor trims oldest first.
ACTIVITY_MAX_EVENTS=50000

# GET /internal/v1/platform-backup streams a consistent copy of platform.db
# from the process that owns the bbolt lock. It is mounted only when
# DNS_SNAPSHOT_BEARER_TOKEN is set, so a role=all deployment that wants
# backups must set one even though it serves no snapshot feed.
# DNS_SNAPSHOT_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Website hosting engine (DeepHost). Every variable is optional: with
# HOSTING_API_URL unset the service is still mounted, reports configured=false
# with these names, and refuses every mutation.
# ---------------------------------------------------------------------------

# Absolute http(s) URL of the DeepHost control plane, or fake:// for the
# in-process fake (rejected when DNS_PRODUCTION=true). The local kind cluster
# listens on 127.0.0.1:30081 and needs no token.
HOSTING_API_URL=http://127.0.0.1:30081

# Bearer token for the control plane. Required unless the host is loopback or
# cluster-local; at least 32 bytes when DNS_PRODUCTION=true.
HOSTING_API_TOKEN=

# Tenant every app is created under. 1-24 characters, [a-z0-9-]; the cap keeps
# slug(tenant)-<app> inside DeepHost's 63-character app identity.
HOSTING_TENANT=simple-test-local

# Where an attached site's apex points. Set the hostname, the addresses, or
# both: the resolved set is unioned with the static one and static entries are
# never removed. For the hostname form add to /etc/hosts:
#   127.0.0.1 gateway.local.test
HOSTING_GATEWAY_HOSTNAME=gateway.local.test
# HOSTING_GATEWAY_ADDRESSES=127.0.0.1

# Optional guard rails on the resolved set: every resolved address must fall
# inside one of these CIDRs, and the resolver to dial instead of the system one.
# HOSTING_GATEWAY_ALLOWED_CIDRS=
# HOSTING_GATEWAY_RESOLVER=

# Platform wildcard hostname for the automatic <app_ref>.<suffix> host, and the
# Kubernetes Secret holding its certificate. The secret is required whenever the
# suffix is set: an auto host is never registered in per-host certificate mode.
# HOSTING_APPS_SUFFIX=
# HOSTING_APPS_TLS_SECRET=

# How long a build may run before the poller marks the deploy ABANDONED (5m-6h).
HOSTING_BUILD_DEADLINE=40m

# Folder uploads. The directory must be writable and, in production, must not
# share a filesystem with DNS_DATA_PATH so an upload cannot fill the DNS volume.
# The janitor sweeps it every 15 minutes but only ever deletes entries whose
# name is an upload id (16 hex, "-", 8 hex) — the staged folder, or the packed
# <upload-id>.tar.zst beside it — so sharing the directory is safe. Both halves
# count against HOSTING_UPLOAD_MAX_TOTAL_BYTES.
HOSTING_UPLOADS_ENABLED=false
HOSTING_UPLOAD_MAX_BYTES=67108864
# HOSTING_UPLOAD_MAX_TOTAL_BYTES=134217728
# HOSTING_UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Mail engine (Stalwart). Only an API key is accepted at runtime; creating and
# rotating it is an operator script (scripts/dev/stalwart-up.sh).
# ---------------------------------------------------------------------------

# Absolute http(s) URL of the Stalwart management API, or fake:// for the
# in-process fake (rejected when DNS_PRODUCTION=true). HTTPS is required in
# production unless the host is cluster-local: the key travels as a bearer.
#
# These three lines stay commented out so this file loads as it stands. Start
# the local server with scripts/dev/stalwart-up.sh, paste the API key it mints
# into MAIL_API_TOKEN, then uncomment all three. A real (non-fake://) mail
# engine also makes DNS_API_BEARER_TOKEN mandatory, because the mail RPCs spend
# that key and return a mailbox password once.
#
# scripts/dev/stalwart-up.sh never prints the key. It writes the whole set to
# <STALWART_DIR>/mail.env (mode 0600; STALWART_DIR defaults to
# $SCRATCH/stalwart-<package>, else $TMPDIR/stalwart-<package>) as
# MAIL_API_URL / MAIL_API_TOKEN / MAIL_HOSTNAME plus the SIMPLE_TEST_STALWART_*
# pair the integration tests read. Load it without echoing anything with:
#
#   set -a; . "$SCRATCH/stalwart-mail/mail.env"; set +a
#
# See docs/mail-runbook.md for rotation and the production equivalent.
# MAIL_API_URL=http://127.0.0.1:20080
# MAIL_API_TOKEN=
# MAIL_HOSTNAME=mail.local.test

# MX preference, SPF include, DMARC policy and the DMARC report address.
# Uncomment these with the block above; a MAIL_* variable without MAIL_API_URL
# is a startup error, not a silently ignored setting.
# MAIL_MX_PRIORITY=10
# MAIL_SPF_INCLUDE=
# MAIL_DMARC_POLICY=quarantine
# MAIL_REPORT_ADDRESS=

# Mailboxes allowed per bound domain (1-500) and the default quota in bytes.
# MAIL_MAILBOXES_PER_DOMAIN=5
# MAIL_DEFAULT_QUOTA_BYTES=5368709120

# Shared secret for the mail server's delivery-event webhook. Empty (the
# default) means POST /mail/v1/delivery-events is not mounted at all, no
# delivered/bounced counters exist and the console says the numbers are not
# available. Set it here AND on the mail server as the webhook's bearer token;
# scripts/dev/stalwart-webhook.sh does the mail server half for a local
# container. At least 32 bytes when DNS_PRODUCTION=true.
# MAIL_WEBHOOK_SECRET=

# The mail server's webhook signatureKey, which is a separate setting there.
# Leave it unset and the one value above stands in for both, so X-Signature is
# keyed with the bearer and proves nothing the bearer did not; set it to a
# second value configured as the server's signatureKey and the signature becomes
# a real second factor — a delivery without X-Signature is then refused. Needs
# MAIL_WEBHOOK_SECRET, and at least 32 bytes when DNS_PRODUCTION=true.
# MAIL_WEBHOOK_SIGNATURE_KEY=

# ---------------------------------------------------------------------------
# Billing (Stripe). "fake" runs an in-process Stripe API on a loopback port and
# is rejected when DNS_PRODUCTION=true; the request-shaping and signature
# verification code is the same in both modes.
# ---------------------------------------------------------------------------

BILLING_PROVIDER=fake

# Where Checkout returns to. Must be HTTPS in production.
BILLING_PUBLIC_URL=http://localhost:3000

# The single Stripe customer this deployment bills. Required for the stripe
# provider; it is also how a rebuilt platform store finds the customer again.
# BILLING_CUSTOMER_EMAIL=

# Stripe credentials. STRIPE_WEBHOOK_SECRET is a comma-separated list of up to
# three whsec_ secrets so a rotation's overlap needs no restart.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# Only the fake provider changes the API base; it is rejected in production.
# STRIPE_API_BASE=https://api.stripe.com

# Fake provider only: the loopback address it binds and the JSON file its state
# survives a restart in.
BILLING_FAKE_ADDR=127.0.0.1:8087
# BILLING_FAKE_STATE_PATH=

# ---------------------------------------------------------------------------
# Web server (apps/web)
# ---------------------------------------------------------------------------

# Server-side base URL the landing page uses to read GET /public/v1/plan. It is
# never sent to the browser (no NEXT_PUBLIC_ prefix); with it unset the landing
# page falls back to the phase-1 DNS-only copy.
DNS_API_URL=http://localhost:8080
