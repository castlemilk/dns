.git
.github
.gitignore
.dockerignore
.serena

**/.DS_Store
**/.env
**/.env.*
!**/.env.example
**/.envrc
**/*.log

# Never send local infrastructure state, credentials, or backend inputs to a
# Docker builder. These are ignored even though the Dockerfiles do not COPY
# them, because remote builders receive the full build context first.
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example
**/backend.hcl
**/.aws
**/.kube
**/kubeconfig
**/kubeconfig.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx

**/node_modules
**/.pnpm-store
**/.next
**/out
**/dist
**/coverage

bin
data
tmp

**/*_test.go
**/*.prof
coverage.out

charts
docs
